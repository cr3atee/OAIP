{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "process",
            "label": "C++: собрать активный файл",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\.vscode\\build.ps1",
                "-Source",
                "${file}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Сборка текущего .cpp-файла компилятором Microsoft Visual C++."
        }
    ]
}
